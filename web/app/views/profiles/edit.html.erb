<% content_for :title, "Edit profile" %>

<%# Reuses the auth card styling — same shape of page: one small form. %>
<div class="auth">
  <h1 class="auth__heading">Edit profile</h1>

  <%= form_with model: @user, url: update_profile_path, method: :patch, class: "auth__form" do |form| %>
    <% if @user.errors.any? %>
      <ul class="auth__errors">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <%= form.label :avatar, "Avatar", class: "auth__label" %>
    <div class="auth__avatar-preview">
      <%= render "shared/avatar", user: @user, size: :display %>
    </div>
    <%= form.file_field :avatar, accept: ImagePolicy::ACCEPT, class: "auth__input" %>
    <p class="auth__hint">PNG, JPEG, WebP or GIF. Will be resized and converted to WebP.</p>

    <%= form.label :username, "Username", class: "auth__label" %>
    <%= form.text_field :username,
          class: "auth__input",
          maxlength: 20,
          pattern: "[a-zA-Z0-9_]{3,20}",
          title: "3–20 characters: letters, numbers and underscores only" %>
    <p class="auth__hint">3–20 characters: letters, numbers and underscores. Must be unique.</p>

    <%= form.label :display_name, "Display name", class: "auth__label" %>
    <%= form.text_field :display_name,
          class: "auth__input",
          maxlength: User::MAX_DISPLAY_NAME_LENGTH,
          placeholder: Current.user.username %>
    <p class="auth__hint">Shown beside your handle. Leave blank to go by @<%= Current.user.username %>.</p>

    <%= form.label :bio, "Bio", class: "auth__label" %>
    <%= form.text_area :bio,
          class: "auth__input auth__input--textarea",
          maxlength: User::MAX_BIO_LENGTH,
          rows: 3 %>
    <p class="auth__hint">Up to <%= User::MAX_BIO_LENGTH %> characters.</p>

    <%= form.submit "Save profile", class: "auth__submit" %>
  <% end %>

  <p class="auth__alternative">
    <%# Current.user, not @user: after a rejected edit @user carries the value
        that was refused, which would aim this link at someone else's profile. %>
    <%= link_to "Back to your profile", profile_path(Current.user.username) %>
  </p>
</div>
