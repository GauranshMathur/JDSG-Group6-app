<% content_for :title, "#{@user.name} (@#{@user.username})" %>

<div class="feed profile">
  <header class="profile__header">
    <div class="profile__avatar">
      <%= render "shared/avatar", user: @user, size: :display %>
    </div>
    <h1 class="profile__name"><%= @user.name %></h1>
    <p class="profile__handle">@<%= @user.username %></p>

    <% if @user.bio.present? %>
      <p class="profile__bio"><%= @user.bio %></p>
    <% end %>

    <p class="profile__joined">Joined <%= @user.created_at.strftime("%B %Y") %></p>

    <%# Presentation only — the edit routes act on Current.user regardless. %>
    <% if @user == Current.user %>
      <%= link_to "Edit profile", edit_profile_path, class: "profile__edit" %>
    <% end %>
  </header>

  <div id="timeline" class="timeline">
    <% @page.items.each do |feed_item| %>
      <%= render "posts/feed_item", feed_item: feed_item,
            liked_post_ids: @page.liked_post_ids, reposted_post_ids: @page.reposted_post_ids %>
    <% end %>

    <% if @page.empty? %>
      <p class="timeline__empty">No posts yet.</p>
    <% end %>
  </div>

  <%= render "posts/pagination", next_url: @page.next_url %>
</div>
