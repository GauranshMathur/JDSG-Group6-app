<%# Authorship comes from the signed-in account, so the composer no longer asks
    who is posting. %>
<%= form_with model: post, id: "composer", class: "composer", data: { controller: "composer-preview" } do |form| %>
  <% if post.errors.any? %>
    <ul class="composer__errors">
      <% post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form.text_area :body,
        class: "composer__body",
        placeholder: "What's happening?",
        rows: 3,
        maxlength: Post::MAX_BODY_LENGTH,
        data: { controller: "submit-on-enter", action: "keydown->submit-on-enter#keydown" } %>

  <div class="composer__row">
    <%# The label's only content is an aria-hidden emoji, so it gives the input
        no accessible name — the input carries its own. %>
    <label class="composer__image-btn" title="Add images">
      <span aria-hidden="true">&#x1F4F7;</span>
      <%= form.file_field :images,
            multiple: true,
            "aria-label": "Add images",
            accept: ImagePolicy::ACCEPT,
            class: "composer__file",
            data: { action: "change->composer-preview#preview" } %>
    </label>
    <%= form.submit "Post", class: "composer__submit" %>
  </div>
  <div class="composer__previews" data-composer-preview-target="container"></div>
<% end %>
