#!/usr/bin/env ruby
# Project what the ranked feed costs at scales that have not been seeded.
#
#   cd web
#   bin/rails runner script/scaling-curve
#
# Seeding 100,000 posts takes about ninety minutes, and the question it would
# answer — does the cost of serving a page keep growing with the database —
# does not need a database to answer.
#
# The two costs that grow are pure Ruby over N entries: rebuilding every
# FeedItem-sized entry out of the cached ordering (`Marshal.load`), and scoring
# and sorting every entry during a rebuild. Neither depends on what the data
# *is*, only how much of it there is — 430,000 two-element arrays of integers
# cost the same whatever the integers are. So rows of the right shape are
# enough. This would not be legitimate for anything where the distribution of
# the data matters, a query plan most of all.
#
# The first row is the size of the real 10k seed, and exists to be checked
# against what the app actually measures. Without that anchor this is
# arithmetic wearing a lab coat.
#
# What it does NOT model, and what therefore must not be read off it:
#
#   * the database. A real rebuild also drags every row into the process, which
#     at the 10k seed is ~580 ms of the ~640 ms it takes. Only the Ruby half is
#     here.
#   * concurrency and the GC pressure that comes with it. Requests are measured
#     one at a time, so the real figures are worse, not better.
#   * the machine you care about. Ratios travel between machines; milliseconds
#     do not.

require "benchmark"

# The ranking, as RankedFeed#score computes it.
def entry_score(likes, reposts, replies, age_hours)
  (likes + (reposts * 2) + replies + 1).to_f / ((age_hours + 2)**1.5)
end

# The 10k seed produces 10,008 top-level posts and 33,050 reposts, so an entry
# count is roughly 4.3x the post count. Sizes below are entry counts.
ANCHOR = 43_058
SIZES = [ ANCHOR, 100_000, 200_000, 430_000, 1_000_000 ].freeze
RUNS = 3

def measure(entries)
  rows = Array.new(entries) do |i|
    [ i + 1, rand(0..400), rand(0..80), rand(0..30), rand * 720.0, (i % 4 == 0 ? i + 2 : nil) ]
  end

  order = nil
  build = RUNS.times.map do
    Benchmark.realtime do
      scored = rows.map do |id, likes, reposts, replies, age, reposter|
        [ entry_score(likes, reposts, replies, age), id, reposter ]
      end
      scored.sort_by! { |entry| -entry.first }
      order = scored.map { |_score, id, reposter| [ id, reposter ] }
    end
  end.min

  dumped = Marshal.dump(order)
  read = RUNS.times.map { Benchmark.realtime { Marshal.load(dumped) } }.min

  [ build, read, dumped.bytesize ]
end

def commas(number) = number.to_s.reverse.scan(/\d{1,3}/).join(",").reverse

puts format("%-14s %13s %13s %11s", "entries", "score+sort", "serve a page", "payload")
SIZES.each do |entries|
  build, read, bytes = measure(entries)
  label = entries == ANCHOR ? "#{commas(entries)} *" : commas(entries)
  puts format("%-14s %11.0f ms %11.1f ms %9.2f MB", label, build * 1000, read * 1000, bytes / 1048576.0)
end

puts
puts "* the 10k seed. Check 'serve a page' here against the app's real figure"
puts "  before trusting the rows below it — see docs/stress-testing.md."
