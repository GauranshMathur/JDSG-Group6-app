#!/usr/bin/env ruby
# Project what the ranked feed costs as activity grows.
#
#   cd web
#   bin/rails runner script/scaling-curve
#
# Since ADR 0011 the ranking considers only entries from inside
# RankedFeed::WINDOW, so the number that drives its cost is no longer how many
# posts the database holds — it is how much happened in the last week. The
# corpus can grow for years without moving these numbers; a busier week moves
# all of them. The sizes below are therefore *window* entry counts: posts
# created plus reposts made in one week.
#
# The two costs that grow with the window are pure Ruby over N entries:
# rebuilding the cached ordering into objects (`Marshal.load`) on every
# request, and scoring and sorting every entry during a rebuild. Neither
# depends on what the data *is*, only how much of it there is, so rows of the
# right shape are enough. This would not be legitimate for anything where the
# distribution of the data matters, a query plan most of all.
#
# The first row is the measured window of the real 10k seed, and exists to be
# checked against what the app actually measures. Without that anchor this is
# arithmetic wearing a lab coat.
#
# What it does NOT model, and what therefore must not be read off it:
#
#   * the database. A real rebuild also drags every window row into the
#     process, which at the 10k seed is most of the ~290 ms a rebuild takes.
#     Only the Ruby half is here.
#   * the archive. Pages past the window are index reads whose cost does not
#     appear in this table at all — that is the point of ADR 0011.
#   * concurrency and the GC pressure that comes with it. Requests are
#     measured one at a time, so the real figures are worse, not better.
#   * the machine you care about. Ratios travel between machines;
#     milliseconds do not.

require "benchmark"

# The ranking, from the one place that defines it. This script does not boot
# Rails, which is why it used to carry its own copy bound only by a comment.
require_relative "../app/services/ranking"

def entry_score(likes, reposts, replies, age_hours)
  Ranking.score(likes: likes, reposts: reposts, replies: replies, age_hours: age_hours)
end

# The re-shaped 10k seed puts 2,348 posts and 11,407 reposts inside the
# 7-day window. The whole-timeline ordering this design replaced held 43,058.
ANCHOR = 13_755
SIZES = [ ANCHOR, 43_058, 100_000, 430_000, 1_000_000 ].freeze
RUNS = 3

def measure(entries)
  rows = Array.new(entries) do |i|
    [ i + 1, rand(0..400), rand(0..80), rand(0..30), rand * 168.0, (i % 4 == 0 ? i + 2 : nil) ]
  end

  order = nil
  build = RUNS.times.map do
    Benchmark.realtime do
      scored = rows.map do |id, likes, reposts, replies, age, reposter|
        [ entry_score(likes, reposts, replies, age), id, reposter ]
      end
      scored.sort_by! { |entry| -entry.first }
      order = scored.map { |_score, id, reposter| [ id, reposter ] }
    end
  end.min

  dumped = Marshal.dump(order)
  read = RUNS.times.map { Benchmark.realtime { Marshal.load(dumped) } }.min

  [ build, read, dumped.bytesize ]
end

def commas(number) = number.to_s.reverse.scan(/\d{1,3}/).join(",").reverse

puts format("%-16s %13s %13s %11s", "window entries", "score+sort", "serve a page", "payload")
SIZES.each do |entries|
  build, read, bytes = measure(entries)
  label =
    case entries
    when ANCHOR then "#{commas(entries)} *"
    when 43_058 then "#{commas(entries)} †"
    else commas(entries)
    end
  puts format("%-16s %11.0f ms %11.1f ms %9.2f MB", label, build * 1000, read * 1000, bytes / 1048576.0)
end

puts
puts "* the 10k seed's measured 7-day window. Check 'serve a page' here against"
puts "  the app's real figure before trusting the rows below it."
puts "† the whole-timeline ordering the window replaced, for comparison: this is"
puts "  what every page used to pay at the same seed, and what a week of this"
puts "  much activity would cost again."
